// ---------------------------------------------------------------------------
// Zellij configuration (KDL)
// Spec: https://zellij.dev/documentation/configuration
// ---------------------------------------------------------------------------
// Design goals:
//   * Clean, minimal status bar: no always-visible keybind list. Shortcuts
//     pop up as a tooltip on mode switch (see layouts/clean.kdl).
//   * Tab bar on top, compact bar (session/mode/tabs) on top, single pane.
//   * Mouse mode, system clipboard, sensible scrollback, nvim scrollback
//     editor.
// ---------------------------------------------------------------------------

// --- UI -------------------------------------------------------------------
// simplified_ui=false keeps the tab bar, compact bar and mode indicator
// visible. The compact-bar plugin ignores this setting (it renders its
// own separators).
simplified_ui false

pane_frames true

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

// --- Mouse ---------------------------------------------------------------
// Click to focus, drag to resize pane borders, scroll wheel to scroll the
// active pane's scrollback, double-click to select a word, shift-drag /
// double-click-drag to extend selection.
mouse_mode true

// --- Theme ---------------------------------------------------------------
// `dracula-soft` (defined further down) tones down the ribbons/frames
// so the bars don't dominate the UI. Swap to `dracula` (or any other
// built-in like catppuccin-mocha / nord / tokyo-night / gruvbox-dark) for
// a louder, high-contrast look.
theme "dracula-soft"

// --- Sessions ------------------------------------------------------------
// Attach to the most recent session or create a new one. When run inside
// another zellij session, mirror it (useful for SSH/remote work).
attach_to_session true
mirror_session true

// --- Layout --------------------------------------------------------------
// Clean layout defined in layouts/clean.kdl. Uses the compact-bar with
// tooltip mode, so keybindings appear only when needed.
default_layout "clean"

// --- Scrollback ----------------------------------------------------------
scroll_buffer_size 10000
scrollback_editor "nvim"

// --- Copy / Paste --------------------------------------------------------
// First command that succeeds wins. Covers Linux (Wayland/X11) and macOS.
copy_command "wl-copy || pbcopy || xclip -selection clipboard || xsel --clipboard"
copy_clipboard "system"
copy_on_select true

// --- Tips ----------------------------------------------------------------
// Disable the noisy startup tips and release-notes banner.
show_startup_tips false
show_release_notes false

// --- Themes --------------------------------------------------------------
// `dracula-soft` reuses dracula's palette but tones down the two bars
// and pane frames that the stock theme renders with bright fills.
//   ribbon_unselected: bright off-white fill -> dracula "current line"
//                      gray with light text.
//   ribbon_selected:   bright green fill       -> dracula purple fill,
//                      so the active tab / mode ribbon is an accent.
//   text_unselected:   pure white on pure black -> light text on dracula
//                      background, blends with the terminal.
//   frame_selected:    bright green             -> dracula purple, so the
//                      focused pane matches the active tab.
//   frame_unselected:  dracula "comment" gray so unfocused frames recede
//                      instead of disappearing.
themes {
    dracula-soft {
        text_unselected {
            base 248 248 242
            background 40 42 54
            emphasis_0 255 184 108
            emphasis_1 139 233 253
            emphasis_2 80 250 123
            emphasis_3 255 121 198
        }
        text_selected {
            base 248 248 242
            background 68 71 90
            emphasis_0 255 184 108
            emphasis_1 139 233 253
            emphasis_2 80 250 123
            emphasis_3 255 121 198
        }
        ribbon_unselected {
            base 248 248 242
            background 68 71 90
            emphasis_0 255 85 85
            emphasis_1 248 248 242
            emphasis_2 189 147 249
            emphasis_3 255 121 198
        }
        ribbon_selected {
            base 40 42 54
            background 189 147 249
            emphasis_0 255 85 85
            emphasis_1 255 184 108
            emphasis_2 255 121 198
            emphasis_3 98 114 164
        }
        frame_unselected {
            base 98 114 164
            background 0
            emphasis_0 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        frame_selected {
            base 189 147 249
            background 0
            emphasis_0 255 184 108
            emphasis_1 139 233 253
            emphasis_2 255 121 198
            emphasis_3 0
        }
        frame_highlight {
            base 255 184 108
            background 0
            emphasis_0 255 121 198
            emphasis_1 255 184 108
            emphasis_2 255 184 108
            emphasis_3 255 184 108
        }
        table_title {
            base 80 250 123
            background 40 42 54
            emphasis_0 255 184 108
            emphasis_1 139 233 253
            emphasis_2 80 250 123
            emphasis_3 255 121 198
        }
        table_cell_selected {
            base 248 248 242
            background 68 71 90
            emphasis_0 255 184 108
            emphasis_1 139 233 253
            emphasis_2 80 250 123
            emphasis_3 255 121 198
        }
        table_cell_unselected {
            base 248 248 242
            background 40 42 54
            emphasis_0 255 184 108
            emphasis_1 139 233 253
            emphasis_2 80 250 123
            emphasis_3 255 121 198
        }
        list_selected {
            base 248 248 242
            background 68 71 90
            emphasis_0 255 184 108
            emphasis_1 139 233 253
            emphasis_2 80 250 123
            emphasis_3 255 121 198
        }
        list_unselected {
            base 248 248 242
            background 40 42 54
            emphasis_0 255 184 108
            emphasis_1 139 233 253
            emphasis_2 80 250 123
            emphasis_3 255 121 198
        }
        exit_code_success {
            base 80 250 123
            background 0
            emphasis_0 139 233 253
            emphasis_1 0 0 0
            emphasis_2 255 121 198
            emphasis_3 98 114 164
        }
        exit_code_error {
            base 255 85 85
            background 0
            emphasis_0 241 250 140
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 255 121 198
            player_2 98 114 164
            player_3 0
            player_4 241 250 140
            player_5 139 233 253
            player_6 0
            player_7 255 85 85
            player_8 0
            player_9 0
            player_10 0
        }
    }
}